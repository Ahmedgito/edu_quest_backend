# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/eduquest

# Auth
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Outbound email (certificate sends and future notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Bulk send pacing (certificate emails): delay between each message, batch size, extra pause after each batch
BULK_EMAIL_DELAY_MS=800
BULK_EMAIL_BATCH_SIZE=5
BULK_EMAIL_BATCH_PAUSE_MS=3000
